# ==============================================
# Twitter Clone Environment Variables Template
# ==============================================

# Application Running Mode & Port
APP_ENV=local
GATEWAY_PORT=9638
# Exact browser origin(s), comma-separated. On ECS use the public scheme, host and port.
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The frontend proxies public tweet media from the internal MinIO service.
MINIO_PUBLIC_URL=/media
JWT_SECRET=your-jwt-secret-key-change-in-production-here

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_NAME=twitter

# Runtime processes validate schema only; use the separate schema-migrate job.
# Paired <ROLE>_DB_USER / <ROLE>_DB_PASSWORD override local legacy credentials.
# Roles: USER_SERVICE, TWEET_SERVICE, FOLLOW_SERVICE, MESSENGER_SERVICE,
# NOTIFICATION_SERVICE, CONSUMER, AGENT_SERVICE, CANAL_RELAY.
# TWEET_SERVICE_DB_USER=twitter_tweet
# TWEET_SERVICE_DB_PASSWORD=your_dedicated_secret
# Production always requires dedicated credentials; local can opt in.
DB_REQUIRE_SERVICE_CREDENTIALS=false
# DB_MIGRATOR_USER=schema_migrator
# DB_MIGRATOR_PASSWORD=your_separate_migration_secret

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration
MQ_HOST=127.0.0.1
MQ_PORT=5672
MQ_USER=guest
MQ_PASSWORD=guest
MQ_VHOST=/

# Service Addresses (For Gateway routing proxies)
USER_SERVICE_ADDR=localhost:9091
TWEET_SERVICE_ADDR=localhost:9092
FOLLOW_SERVICE_ADDR=localhost:9093

# MongoDB Configuration (For Messenger & Agent sessions)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=your_mongodb_password_here
MONGO_DB_NAME=twitter_agent

# Elasticsearch (For Text & Vector Search)
ES_ADDRESSES=http://localhost:9200

# Local Embedding Server (e.g. LM Studio)
LM_STUDIO_API_URL=http://localhost:1234/v1
# Optional bearer token when the OpenAI-compatible endpoint requires authentication.
LM_STUDIO_API_TOKEN=
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL_EMBEDDING=text-embedding-bge-m3

# LLM Chat API (e.g. Aliyun DashScope / Qwen)
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key_here
LM_STUDIO_MODEL_CHAT=qwen2.5-3b-instruct

# Episodic Memory and RAG scoring
AGENT_EPISODIC_COLLECTION=agent_episodic_memory
AGENT_EPISODIC_EMBEDDING_VERSION=v1
# Keep enabled until all episodic_user_<id> collections have been migrated.
AGENT_EPISODIC_LEGACY_READ_ENABLED=true
AGENT_RAG_SIMILARITY_THRESHOLD=0.65
AGENT_RAG_SIMILARITY_WEIGHT=0.60
AGENT_RAG_TIME_DECAY_WEIGHT=0.25
AGENT_RAG_FREQUENCY_WEIGHT=0.15
AGENT_RAG_TIME_DECAY_LAMBDA=0.00001
AGENT_RAG_KEYWORD_BONUS=0.15
# Used only by the opt-in cmd/agent-rag-eval comparison runner.
AGENT_RAG_EVAL_COLLECTION=tweets
AGENT_RAG_EVAL_DATASET_VERSION=rag_cases-v1
# RAG eval is live-only and requires --allow-live. Keys are env-only.
AGENT_RAG_EVAL_STRATEGIES=bm25,vector,rrf,rrf_rerank
AGENT_RAG_EVAL_ALLOWED_HOSTS=localhost,127.0.0.1,::1
AGENT_RAG_EVAL_CASE_TIMEOUT=15s
AGENT_RAG_EVAL_TIMEOUT=10m
AGENT_RAG_EVAL_EMBEDDING_PROVIDER=lmstudio
AGENT_RAG_EVAL_EMBEDDING_BASE_URL=http://localhost:1234/v1
AGENT_RAG_EVAL_EMBEDDING_MODEL=text-embedding-bge-m3
AGENT_RAG_EVAL_EMBEDDING_API_KEY=
AGENT_ROUTER_EVAL_DATASET_VERSION=router-cases-v1
# Router eval defaults to lexical/offline. semantic/llm/full additionally
# require the explicit --allow-live CLI flag; API keys are read only from env.
AGENT_ROUTER_EVAL_MODE=lexical
AGENT_ROUTER_EVAL_SEMANTIC_THRESHOLD=0.82
AGENT_ROUTER_EVAL_CASE_TIMEOUT=15s
AGENT_ROUTER_EVAL_TIMEOUT=5m
AGENT_ROUTER_EVAL_EMBEDDING_PROVIDER=lmstudio
AGENT_ROUTER_EVAL_EMBEDDING_BASE_URL=http://localhost:1234/v1
AGENT_ROUTER_EVAL_EMBEDDING_MODEL=text-embedding-bge-m3
AGENT_ROUTER_EVAL_EMBEDDING_API_KEY=
AGENT_ROUTER_EVAL_EMBEDDING_INPUT_MICROS_PER_MILLION=0
AGENT_ROUTER_EVAL_EMBEDDING_PRICING_VERSION=unpriced
AGENT_ROUTER_EVAL_LLM_PROVIDER=dashscope
AGENT_ROUTER_EVAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_ROUTER_EVAL_LLM_MODEL=qwen-plus
AGENT_ROUTER_EVAL_LLM_API_KEY=
AGENT_ROUTER_EVAL_LLM_INPUT_MICROS_PER_MILLION=0
AGENT_ROUTER_EVAL_LLM_OUTPUT_MICROS_PER_MILLION=0
AGENT_ROUTER_EVAL_LLM_PRICING_VERSION=unpriced

# Tweet Publishing Limits
TWEET_MAX_CONTENT_LENGTH=10000
TWEET_HARD_MAX_CONTENT_LENGTH=20000
# Optional Agent -> Tweet credential. When empty, only the two privileged
# risk-control RPCs are unavailable; public Tweet RPCs continue to work.
# Use a random value of at least 32 bytes and deliver it through a Secret in production.
TWEET_INTERNAL_SERVICE_IDENTITY=agent-service
TWEET_INTERNAL_SERVICE_TOKEN=

# Agent Service Configuration
SERVICE_NAME=agent-service
SERVICE_PORT=9100
# Process role controls which top-level components are started. Use `all` for
# the current single-process deployment, or split `api` and `worker` instances.
AGENT_PROCESS_ROLE=all
# Shared Runtime/Workflow admission requires explicit Redis policy initialization.
# API/all additionally require AGENT_RUNTIME_V2_MODES=all before dependency startup.
# Cost reservations are disabled until an upper price in micros/token is set.
AGENT_SHARED_ADMISSION_ENABLED=false
AGENT_SHARED_ADMISSION_NAMESPACE=agent-v1
AGENT_SHARED_ADMISSION_LEASE=30s
AGENT_SHARED_MAX_RUNS=64
AGENT_SHARED_MAX_USER_RUNS=2
AGENT_SHARED_MAX_WORKFLOW_RUNS=2
AGENT_SHARED_MAX_PROVIDER_CALLS=8
AGENT_SHARED_MAX_PER_PROVIDER=8
AGENT_SHARED_OUTPUT_TOKEN_LIMIT=4096
AGENT_SHARED_TOKEN_BUDGET_PER_MINUTE=250000
AGENT_SHARED_COST_BUDGET_PER_MINUTE=0
AGENT_SHARED_COST_MICROS_PER_TOKEN=0
# Temporal is the only production Trending Reporter scheduler. Set disabled to
# stop automatic reports; the legacy in-process ticker is never auto-started.
AGENT_TRENDING_REPORTER_OWNER=temporal
AGENT_TRENDING_REPORTER_INTERVAL=1m
MCP_SERVER_ADDR=127.0.0.1:9200
# Optional. When empty, agent-service generates a process-local 256-bit token.
# Set at least 32 random characters only when another trusted local client must connect.
AGENT_MCP_AUTH_TOKEN=
AGENT_METRICS_PORT=9191
CONSUMER_METRICS_PORT=2116
# Optional diagnostic owner. Leave empty to use hostname + PID + random suffix.
TIMELINE_OUTBOX_WORKER_ID=
AGENT_TRACE_SAMPLE_RATIO=1
# Remote MCP control plane. Discovery and future execution remain disabled
# unless explicitly enabled. Public DNS/IP validation is always enforced;
# allowlist entries are intended only for controlled internal test hosts.
AGENT_EXTERNAL_MCP_ENABLED=false
# Publishes explicitly approved immutable workflow revisions into the Unified
# Agent catalog. Write/risky steps additionally require governed continuation.
AGENT_WORKFLOW_AS_TOOL_ENABLED=false
AGENT_WORKFLOW_TOOL_CATALOG_LIMIT=20
AGENT_WORKFLOW_TOOL_TIMEOUT=60s
# Exposes versioned Skill projections and the explicit skill.run route.
# Requires AGENT_WORKFLOW_AS_TOOL_ENABLED=true. Disable for instant rollback;
# Workflow publication metadata remains unchanged.
AGENT_SKILL_CATALOG_ENABLED=false
AGENT_SKILL_CATALOG_LIMIT=20
# Credential-free tenant directory for built-in capabilities, immutable Skills
# and reviewed MCP tools. Execution remains governed by each source authority.
AGENT_EXTENSION_CATALOG_ENABLED=false
AGENT_EXTENSION_CATALOG_LIMIT=20
# Signature-verified public release directory. It does not expose installation,
# dependency resolution or package execution.
AGENT_EXTENSION_MARKETPLACE_ENABLED=false
AGENT_EXTENSION_MARKETPLACE_LIMIT=20
# Authenticated publisher control plane. The same 32+ character internal token
# must be configured on Gateway and Agent Service. Administrator IDs bootstrap
# publishers; publisher owners are then stored in Mongo and checked server-side.
AGENT_EXTENSION_MARKETPLACE_ADMIN_ENABLED=false
AGENT_EXTENSION_MARKETPLACE_ADMIN_TOKEN=
AGENT_EXTENSION_MARKETPLACE_ADMIN_USER_IDS=
# Enables persistent Agent projects and project-scoped MCP sharing. Requires
# AGENT_EXTERNAL_MCP_ENABLED=true; member additions are verified by User Service.
AGENT_EXTERNAL_MCP_PROJECT_SCOPE_ENABLED=false
# Deployment-managed credentials are available only to project connections.
# Registry metadata never contains a token; secret_key names a file below the
# dedicated read-only secret directory. Example:
# [{"reference":"team.research","project_id":"agentproj_...","endpoint":"https://mcp.example.com/mcp","auth_type":"bearer","secret_key":"research-token","version":1}]
AGENT_EXTERNAL_MCP_MANAGED_CREDENTIALS_ENABLED=false
AGENT_EXTERNAL_MCP_MANAGED_CREDENTIALS_JSON=[]
AGENT_EXTERNAL_MCP_MANAGED_CREDENTIAL_SECRET_DIR=/var/run/secrets/agent-mcp-managed
# Persists authoritative Unified Agent lifecycle records and enables encrypted
# ask_human and approval checkpoints when the matching governance flag is on.
AGENT_RECOVERABLE_RUNS_ENABLED=false
# Default-off production Planning-Execute canary. Each route has an independent
# capability flag and requires recoverable execution records.
# Set the master flag, selected route flag and a stable canary percentage.
AGENT_PLANNING_EXECUTE_ENABLED=false
AGENT_PLANNING_EXECUTE_CANARY_PERCENT=0
AGENT_PLANNING_EXECUTE_PLATFORM_SEARCH_ENABLED=false
AGENT_PLANNING_EXECUTE_WEB_RESEARCH_ENABLED=false
AGENT_PLANNING_EXECUTE_EXTERNAL_MCP_READ_ENABLED=false
# Also requires AGENT_EXTERNAL_MCP_ENABLED and
# AGENT_UNIFIED_APPROVAL_RECOVERY_ENABLED. Write tools remain approval-gated and
# use platform-derived idempotency keys.
AGENT_PLANNING_EXECUTE_EXTERNAL_MCP_WRITE_ENABLED=false
AGENT_PLANNING_EXECUTE_WORKFLOW_READ_ENABLED=false
AGENT_PLANNING_MAX_OUTPUT_TOKENS=768
AGENT_PLANNING_PARSE_REPAIRS=1
AGENT_PLANNING_ADMISSION_REPAIRS=1
# Global kill switch for the observation-only Goal Runtime rollout. The
# task-specific shadows consume the existing Runtime result and never repeat
# model, tool or external Web calls. The global and matching task flags must
# both be true to emit comparisons.
AGENT_GOAL_RUNTIME_ENABLED=false
AGENT_GOAL_RUNTIME_PLATFORM_SEARCH_SHADOW_ENABLED=false
AGENT_GOAL_RUNTIME_WEB_RESEARCH_SHADOW_ENABLED=false
AGENT_GOAL_RUNTIME_GROUNDED_DRAFT_SHADOW_ENABLED=false
AGENT_GOAL_RUNTIME_RESEARCH_DRAFT_SHADOW_ENABLED=false
# Explicit task templates require authoritative completed Agent Runs. Disabling
# execution preserves stored templates for listing and archival.
AGENT_TASK_TEMPLATES_ENABLED=false
AGENT_TASK_TEMPLATE_LIST_LIMIT=20
AGENT_UNIFIED_APPROVAL_RECOVERY_ENABLED=false
# Deterministic Multi-Agent admission shadow. This records complexity,
# role/tool scopes and budget/latency fallback evidence; the current release
# still executes the existing single-Agent route.
AGENT_MULTI_AGENT_PLANNER_ENABLED=false
# Enables the bounded sequential researcher/drafter/reviewer executor for
# admitted research-draft plans. Requires planner + recoverable runs.
AGENT_MULTI_AGENT_EXECUTION_ENABLED=false
AGENT_MULTI_AGENT_MIN_COMPLEXITY_SCORE=6
AGENT_MULTI_AGENT_MAX_ROLES=3
AGENT_MULTI_AGENT_MAX_PARALLEL_ROLES=1
AGENT_MULTI_AGENT_MAX_ESTIMATED_LATENCY=50s
# Required when recoverable runs are enabled. Use an independent 32-byte
# base64 AES key; do not reuse the Provider Config credential key.
AGENT_RUN_CHECKPOINT_MASTER_KEY=
AGENT_RUN_CHECKPOINT_ACTIVE_KEY_ID=v1
# Rotation keyring: "v1:base64,v2:base64". Keep old keys until all suspended
# runs encrypted with them have completed or been explicitly retired.
AGENT_RUN_CHECKPOINT_MASTER_KEYS=
AGENT_RUN_CHECKPOINT_MAX_BYTES=262144
AGENT_RUN_RESUME_LEASE_DURATION=5m
AGENT_EXTERNAL_MCP_ALLOWED_HOSTS=
AGENT_EXTERNAL_MCP_POOL_ENABLED=true
AGENT_EXTERNAL_MCP_POOL_MAX_SESSIONS=64
AGENT_EXTERNAL_MCP_POOL_MAX_SESSIONS_PER_CONNECTION=2
AGENT_EXTERNAL_MCP_POOL_IDLE_TIMEOUT=5m
AGENT_EXTERNAL_MCP_POOL_ACQUIRE_TIMEOUT=2s
# Active checks are separately gated. Health is advisory and never grants or
# revokes a tool policy; Mongo leases prevent duplicate checks across replicas.
AGENT_EXTERNAL_MCP_HEALTH_CHECK_ENABLED=false
AGENT_EXTERNAL_MCP_HEALTH_POLL_INTERVAL=15s
AGENT_EXTERNAL_MCP_HEALTH_INTERVAL=2m
AGENT_EXTERNAL_MCP_HEALTH_TIMEOUT=5s
AGENT_EXTERNAL_MCP_HEALTH_LEASE_DURATION=15s
AGENT_EXTERNAL_MCP_HEALTH_FAILURE_BACKOFF_MIN=30s
AGENT_EXTERNAL_MCP_HEALTH_FAILURE_BACKOFF_MAX=15m
AGENT_EXTERNAL_MCP_HEALTH_FAILURE_THRESHOLD=3
AGENT_EXTERNAL_MCP_HEALTH_BATCH_SIZE=20
AGENT_EXTERNAL_MCP_HEALTH_MAX_CONCURRENCY=4

# Used only by cmd/agent-mcp-acceptance. The target bearer token is referenced
# by that command's strict config through an environment variable or file.
AGENT_MCP_ACCEPTANCE_INTEGRITY_KEY=
AGENT_MCP_ACCEPTANCE_INTEGRITY_KEY_ID=
AGENT_MCP_CONFORMANCE_TOKEN=
# Governed public web search. Disabled by default. When enabled, the platform
# key is optional because users may select an encrypted Brave Provider Config.
# Deployment limits, endpoint policy and budgets still remain server-owned.
AGENT_WEB_SEARCH_ENABLED=false
AGENT_WEB_SEARCH_PROVIDER=brave
AGENT_WEB_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
AGENT_WEB_SEARCH_API_KEY=
AGENT_WEB_SEARCH_TIMEOUT=10s
AGENT_WEB_SEARCH_MAX_RESULTS=10
AGENT_WEB_SEARCH_MAX_RESPONSE_BYTES=2097152
AGENT_WEB_SEARCH_MAX_CONCURRENT=8
AGENT_WEB_SEARCH_CACHE_TTL=5m
# Exceptional internal test endpoints only. Public provider hosts do not need
# an allowlist entry and still undergo DNS/IP validation.
AGENT_WEB_SEARCH_ALLOWED_HOSTS=
# Safe public page reader. It is available only when web search is enabled.
AGENT_WEB_PAGE_READ_ENABLED=true
AGENT_WEB_PAGE_TIMEOUT=12s
AGENT_WEB_PAGE_MAX_RESPONSE_BYTES=2097152
AGENT_WEB_PAGE_MAX_CONTENT_RUNES=16000
AGENT_WEB_PAGE_MAX_CONCURRENT=8
AGENT_WEB_PAGE_CACHE_TTL=15m
AGENT_WEB_PAGE_ALLOWED_HOSTS=
# Redis-backed source cache and fail-closed user/run admission budgets.
AGENT_WEB_CACHE_PREFIX=agent:web:cache
AGENT_WEB_GOVERNOR_PREFIX=agent:web:governor
AGENT_WEB_USER_RATE_WINDOW=1m
AGENT_WEB_USER_MAX_REQUESTS=30
AGENT_WEB_RUN_TTL=24h
AGENT_WEB_RUN_MAX_REQUESTS=12
AGENT_WEB_RUN_MAX_COST_MICROS=50000
AGENT_WEB_SEARCH_ESTIMATED_COST_MICROS=1000
AGENT_WEB_PAGE_ESTIMATED_COST_MICROS=100
# Prompt/Completion previews are stored only in tenant-scoped Mongo Trace.
# Keep disabled by default; enabled samples are deterministic, sensitive-content
# rejecting and bounded to the configured UTF-8 byte length.
AGENT_PROMPT_SAMPLING_ENABLED=false
AGENT_PROMPT_SAMPLE_RATIO=0.01
AGENT_PROMPT_SAMPLE_MAX_BYTES=512
# Comma-separated: chat,consult,assist,multi,workflow. Empty keeps all legacy paths.
AGENT_RUNTIME_V2_MODES=

# Semantic session compaction. The summary model must be a chat model; never
# configure an embedding model here. Production should use a reachable model
# instead of relying on the optional local LM Studio endpoint.
AGENT_SESSION_SUMMARY_MODEL=qwen2.5-3b-instruct
AGENT_SESSION_SUMMARY_MIN_MESSAGES=12
AGENT_SESSION_SUMMARY_IDLE_DELAY=2m
AGENT_SESSION_SUMMARY_SWEEP_INTERVAL=15s
# Strict JSON array. Basis points are 0..10000 and partial releases require a
# stable salt. Empty array keeps assist.draft on v1.
# Example: [{"profile_id":"assist.draft","stable_version":"v1","candidate_version":"v2","candidate_basis_points":1000,"salt":"assist-v2-canary"}]
AGENT_PROFILE_RELEASES=[]
# Load published Agent Profile versions/releases from MongoDB. Set false for
# emergency rollback to the built-in catalog plus AGENT_PROFILE_RELEASES.
AGENT_PROFILE_STORE_ENABLED=true
# Redis invalidation hint plus periodic Mongo anti-entropy refresh.
AGENT_PROFILE_CHANGE_CHANNEL=agent.profile.catalog.changed.v1
AGENT_PROFILE_SYNC_INTERVAL=30s
# Optional Profile management plane. Configure the same 32+ character token
# on gateway and agent-service. Editor and approver should be different users.
AGENT_PROFILE_ADMIN_TOKEN=
# Read-only catalog access.
AGENT_PROFILE_VIEWER_USER_IDS=
# Draft creation and publish-request submission.
AGENT_PROFILE_EDITOR_USER_IDS=
# Publish approval/rejection and failed-application recovery.
AGENT_PROFILE_APPROVER_USER_IDS=
# Full access, including Release changes. Admin is also editor and approver.
AGENT_PROFILE_ADMIN_USER_IDS=
# Persist project-level role bindings in Agent Mongo. Requires at least one
# static admin above. Disable to use only static role lists during rollback.
AGENT_PROFILE_DYNAMIC_RBAC_ENABLED=true
# Emergency escape hatch only. Normal publishing must use two-person approval.
AGENT_PROFILE_DIRECT_PUBLISH_ENABLED=false
# Runtime-metric A/B safety gate. Requires the Profile store, admin token and
# at least one static admin. Disable for immediate rollback of the controller.
AGENT_PROFILE_EXPERIMENTS_ENABLED=false
AGENT_PROFILE_EXPERIMENT_RECONCILE_INTERVAL=30s
AGENT_PROFILE_EXPERIMENT_OBSERVATION_QUEUE_SIZE=1024
# First external like/comment within this window can satisfy content_engaged.
# Self-interactions and inactivity never create outcomes.
AGENT_PROFILE_CONTENT_ATTRIBUTION_WINDOW=168h
# Require a signed live Agent Eval report archived under MinIO Object Lock
# before a draft can enter two-person publish approval. Roll back with false.
AGENT_PROFILE_EVAL_EVIDENCE_REQUIRED=false
# Require the immutable evidence object to include an approved external-human
# content review signoff. Requires AGENT_PROFILE_EVAL_EVIDENCE_REQUIRED=true.
AGENT_PROFILE_EVAL_CONTENT_SIGNOFF_REQUIRED=false
AGENT_TASK_EVAL_ARCHIVE_ENDPOINT=localhost:9000
AGENT_TASK_EVAL_ARCHIVE_ACCESS_KEY=
AGENT_TASK_EVAL_ARCHIVE_SECRET_KEY=
AGENT_TASK_EVAL_ARCHIVE_BUCKET=agent-task-eval-reports
AGENT_TASK_EVAL_ARCHIVE_SECURE=false
# Dedicated 32+ byte HMAC key and non-empty rotation identifier. Never commit values.
AGENT_TASK_EVAL_INTEGRITY_KEY=
AGENT_TASK_EVAL_INTEGRITY_KEY_ID=
# Independent 32+ byte HMAC key used only for content-review signoffs.
AGENT_TASK_EVAL_REVIEW_SIGNOFF_KEY=
AGENT_TASK_EVAL_REVIEW_SIGNOFF_KEY_ID=

# Agent Runtime admission limits (single agent-service process)
AGENT_MAX_CONCURRENT_RUNS_PER_USER=4
AGENT_MAX_CONCURRENT_RUNS_PER_WORKFLOW=2
# Workflow-wide defaults. A saved DSL budget can lower or override these
# values within the server hard caps. Cost 0 disables monetary enforcement.
AGENT_WORKFLOW_MAX_NODE_EXECUTIONS=50
AGENT_WORKFLOW_MAX_PARALLEL_NODES=8
AGENT_WORKFLOW_TIMEOUT_SEC=300
AGENT_WORKFLOW_MAX_TOTAL_TOKENS=120000
AGENT_WORKFLOW_MAX_ESTIMATED_COST_MICROS=0
AGENT_WORKFLOW_CANCEL_POLL_INTERVAL=500ms
AGENT_WORKFLOW_EVENT_HEARTBEAT=10s
AGENT_WORKFLOW_EVENT_STREAM_WINDOW=2m
AGENT_WORKFLOW_EVENT_STREAM_MAX_LENGTH=2000
AGENT_WORKFLOW_EVENT_STREAM_TTL=24h
# Reclaim expired in-flight compensation leases. Approval-protected tools are
# moved to explicit user retry instead of being executed by the background job.
AGENT_WORKFLOW_COMPENSATION_RECONCILE_INTERVAL=30s
AGENT_WORKFLOW_COMPENSATION_RECONCILE_BATCH_SIZE=50
# Pending tool approvals expire automatically; Go duration syntax.
AGENT_TOOL_APPROVAL_TTL=15m
AGENT_TOOL_RECONCILE_INTERVAL=30s
AGENT_TOOL_BREAKER_FAILURE_THRESHOLD=5
AGENT_TOOL_BREAKER_OPEN_TIMEOUT=30s
# Tool results are JSON encoded before they enter Trace or model context.
# Results above the hard max fail with result_too_large. Results above the
# inline threshold require the private object store; disable it for rollback.
AGENT_TOOL_RESULT_INLINE_MAX_BYTES=65536
AGENT_TOOL_RESULT_MAX_BYTES=1048576
AGENT_TOOL_RESULT_OBJECT_STORE_ENABLED=false
AGENT_TOOL_RESULT_MINIO_ENDPOINT=localhost:9000
AGENT_TOOL_RESULT_MINIO_ACCESS_KEY=
AGENT_TOOL_RESULT_MINIO_SECRET_KEY=
AGENT_TOOL_RESULT_MINIO_BUCKET=agent-tool-results
AGENT_TOOL_RESULT_MINIO_SECURE=false

# Internal Python support-agent -> Go capability query boundary. The route is
# absent unless explicitly enabled. Use the same 32+ byte secret on both
# services, preferably mounted through SUPPORT_QUERY_JWT_SECRET_FILE.
SUPPORT_QUERY_ENABLED=false
SUPPORT_QUERY_JWT_SECRET=
SUPPORT_QUERY_JWT_SECRET_FILE=
SUPPORT_QUERY_JWT_ISSUER=support-agent-service
SUPPORT_QUERY_JWT_AUDIENCE=twitter-support-query
SUPPORT_QUERY_JWT_SUBJECT=support-agent-service
SUPPORT_QUERY_JWT_MAX_TTL=2m
SUPPORT_QUERY_TIMEOUT=3s
SUPPORT_QUERY_IDEMPOTENCY_TTL=10m

# Application data retention runs only in the Agent worker role. Keep disabled
# until a dry-run report is reviewed. WORM Agent eval reports are excluded.
AGENT_DATA_RETENTION_ENABLED=false
AGENT_DATA_RETENTION_DRY_RUN=true
AGENT_DATA_RETENTION_INTERVAL=6h
AGENT_DATA_RETENTION_LEASE_DURATION=15m
AGENT_DATA_RETENTION_OPERATION_TIMEOUT=2m
AGENT_DATA_RETENTION_BATCH_SIZE=100
AGENT_DIALOGUE_RETENTION=4320h
AGENT_ORPHAN_MESSAGE_GRACE_PERIOD=24h
AGENT_TRACE_RETENTION=720h
AGENT_TERMINAL_CHECKPOINT_RETENTION=168h
AGENT_SUSPENDED_CHECKPOINT_RETENTION=720h
AGENT_TOOL_RESULT_RETENTION=720h

# Provider catalog pricing. Values are currency micros per one million tokens.
# Keep zero when a provider has no configured billable price.
AGENT_DASHSCOPE_PRICING_VERSION=unpriced
AGENT_DASHSCOPE_INPUT_MICROS_PER_MILLION=0
AGENT_DASHSCOPE_OUTPUT_MICROS_PER_MILLION=0
AGENT_LMSTUDIO_PRICING_VERSION=local-v1
AGENT_LMSTUDIO_INPUT_MICROS_PER_MILLION=0
AGENT_LMSTUDIO_OUTPUT_MICROS_PER_MILLION=0

# AES-256-GCM key shared by tenant Provider Config and external MCP credentials.
# Supply exactly 32 bytes in base64.
# For key rotation, set ACTIVE_KEY_ID and MASTER_KEYS as "v1:base64,v2:base64".
# AGENT_PROVIDER_CONFIG_MASTER_KEY=
# AGENT_PROVIDER_CONFIG_ACTIVE_KEY_ID=v1
# AGENT_PROVIDER_CONFIG_MASTER_KEYS=

# Canal historical gaps require an explicitly reviewed recovery decision.
CANAL_ALLOW_CURRENT_POSITION_BOOTSTRAP=false
CANAL_ALLOW_PURGED_POSITION_RECOVERY=false

# Reviewed additive schema required before enabling persistent publish receipts.
CANAL_PUBLICATION_RECEIPTS_ENABLED=false
FOLLOW_PROJECTION_WORKER_ENABLED=false
