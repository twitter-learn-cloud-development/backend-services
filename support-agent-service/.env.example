# Settings use the SUPPORT_AGENT_ prefix. This file is a template only; never
# commit real values. The local joint stack reads provider/Mongo credentials
# from the Go repository's Git-ignored .env.
SUPPORT_AGENT_AUDIT_HMAC_KEY=replace-with-at-least-32-random-characters

# Twitter Auth service RS256/JWKS user-token verification.
SUPPORT_AGENT_USER_JWKS_URL=http://localhost:8081/.well-known/jwks.json
SUPPORT_AGENT_USER_JWT_ISSUER=twitter-clone-auth
SUPPORT_AGENT_USER_JWT_AUDIENCE=twitter-clone-users

# OpenAI-compatible chat and embedding endpoint.
SUPPORT_AGENT_MODEL_BASE_URL=
SUPPORT_AGENT_MODEL_NAME=
SUPPORT_AGENT_MODEL_API_KEY=

# Enable Qdrant in the support-agent process only when all three values are configured.
SUPPORT_AGENT_QDRANT_URL=
SUPPORT_AGENT_QDRANT_API_KEY=
SUPPORT_AGENT_EMBEDDING_MODEL_NAME=

# Python support agent -> Go Gateway internal capability boundary.
SUPPORT_AGENT_SUPPORT_QUERY_BASE_URL=http://localhost:9638
SUPPORT_AGENT_SUPPORT_QUERY_JWT_SECRET=
