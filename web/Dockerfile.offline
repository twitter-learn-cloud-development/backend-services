# syntax=docker/dockerfile:1.7

# From the repository root after `npm run build` in web/:
# docker build --network none --build-context config=./web -f web/Dockerfile.offline web/dist
FROM nginx:alpine
COPY . /usr/share/nginx/html
COPY --from=config /nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 5556
CMD ["nginx", "-g", "daemon off;"]
